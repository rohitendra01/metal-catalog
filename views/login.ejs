<section class="min-h-[80vh] flex items-center justify-center py-20 bg-white dark:bg-[#0a0a0a]">
    <div class="w-full max-w-md mx-auto px-4">
        <div
            class="bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-10 md:p-14 relative fade-in-up shadow-2xl">
            <!-- Top Structural Bar -->
            <div class="absolute top-0 left-0 w-full h-2 bg-orange-600"></div>

            <!-- Logo Header -->
            <div class="text-center mb-10">
                <a href="/" class="inline-flex items-center gap-3">
                    <span
                        class="font-display font-black text-3xl text-zinc-950 dark:text-white uppercase tracking-tighter">
                        Panda<span class="text-orange-600">Metals</span>
                    </span>
                </a>
                <p class="text-zinc-500 font-mono text-xs uppercase tracking-[0.2em] mt-4">Authorized Access Only</p>
            </div>

            <% if (error) { %>
                <div
                    class="mb-8 p-4 bg-red-600/10 border border-red-600 text-red-600 dark:text-red-500 font-mono text-xs uppercase tracking-widest text-center">
                    Error // <%= error %>
                </div>
                <% } %>

                    <form action="/login" method="POST" class="space-y-6">
                        <div>
                            <label
                                class="block text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-3">System
                                ID</label>
                            <input type="text" name="username" required autofocus
                                class="w-full px-5 py-4 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 transition-colors rounded-none placeholder-zinc-400"
                                placeholder="ENTER USERNAME" />
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-3">Passcode</label>
                            <input type="password" name="password" required
                                class="w-full px-5 py-4 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono tracking-[0.3em] focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 transition-colors rounded-none placeholder-zinc-400"
                                placeholder="••••••••" />
                        </div>

                        <button type="submit"
                            class="w-full py-5 mt-4 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold text-sm uppercase tracking-widest hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors">
                            Initialize Login
                        </button>
                    </form>

                    <div class="mt-10 text-center border-t border-zinc-200 dark:border-zinc-800 pt-8">
                        <a href="/"
                            class="text-zinc-500 hover:text-orange-600 font-bold text-xs uppercase tracking-widest transition-colors">
                            ← Return to Catalog
                        </a>
                    </div>
        </div>
    </div>
</section>