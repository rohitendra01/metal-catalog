<!-- Hero Section: Split Editorial Layout with Product Showcase -->
<section
    class="relative min-h-[90vh] flex items-center bg-white dark:bg-[#0a0a0a] border-b border-zinc-200 dark:border-zinc-800">
    <div class="absolute inset-0 grid grid-cols-1 lg:grid-cols-2 w-full h-full pointer-events-none">
        <div class="bg-white dark:bg-[#0a0a0a] h-full"></div>
        <!-- Right Side: Live Database Product Showcase replacing the blur section -->
        <div
            class="bg-zinc-50 dark:bg-zinc-900 h-full relative overflow-hidden hidden lg:flex items-center justify-center p-12 border-l border-zinc-200 dark:border-zinc-800 pointer-events-auto">
            <!-- Subtle background dot matrix -->
            <div
                class="absolute inset-0 bg-[radial-gradient(#3f3f46_1px,transparent_1px)] [background-size:24px_24px] opacity-25">
            </div>

            <% if (featured && featured.length> 0) { %>
                <div class="relative w-full max-w-lg grid grid-cols-2 gap-4 z-10">
                    <!-- Main Feature Hero Card -->
                    <a href="/products/<%= featured[0].slug %>"
                        class="col-span-2 group relative h-72 bg-zinc-900 overflow-hidden border border-zinc-800 shadow-2xl block">
                        <% if (featured[0].images && featured[0].images.length> 0) { %>
                            <img src="<%= featured[0].images[0].url %>" alt="<%= featured[0].name %>"
                                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                loading="lazy" />
                            <% } %>
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent opacity-85">
                                </div>
                                <div class="absolute top-4 left-4">
                                    <span
                                        class="px-2.5 py-1 bg-orange-600 text-white text-[10px] font-bold uppercase tracking-widest">Featured</span>
                                </div>
                                <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
                                    <div>
                                        <span
                                            class="text-zinc-400 text-[10px] font-mono uppercase tracking-widest block mb-1">SN:
                                            <%= featured[0].serialNo %></span>
                                        <h4 class="text-white font-bold text-lg uppercase tracking-tight line-clamp-1">
                                            <%= featured[0].name %>
                                        </h4>
                                    </div>
                                    <span class="text-white font-mono font-black text-xl">₹<%=
                                            featured[0].price.toLocaleString('en-IN') %></span>
                                </div>
                    </a>

                    <!-- Secondary Feature Card 1 -->
                    <% if (featured[1]) { %>
                        <a href="/products/<%= featured[1].slug %>"
                            class="group relative h-48 bg-zinc-900 overflow-hidden border border-zinc-800 shadow-xl block">
                            <% if (featured[1].images && featured[1].images.length> 0) { %>
                                <img src="<%= featured[1].images[0].url %>" alt="<%= featured[1].name %>"
                                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    loading="lazy" />
                                <% } %>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-85">
                                    </div>
                                    <div class="absolute bottom-3 left-3 right-3">
                                        <h4 class="text-white font-bold text-sm uppercase tracking-tight truncate">
                                            <%= featured[1].name %>
                                        </h4>
                                        <span class="text-orange-400 font-mono text-xs font-bold">₹<%=
                                                featured[1].price.toLocaleString('en-IN') %></span>
                                    </div>
                        </a>
                        <% } %>

                            <!-- Secondary Feature Card 2 -->
                            <% if (featured[2]) { %>
                                <a href="/products/<%= featured[2].slug %>"
                                    class="group relative h-48 bg-zinc-900 overflow-hidden border border-zinc-800 shadow-xl block">
                                    <% if (featured[2].images && featured[2].images.length> 0) { %>
                                        <img src="<%= featured[2].images[0].url %>" alt="<%= featured[2].name %>"
                                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                            loading="lazy" />
                                        <% } %>
                                            <div
                                                class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-85">
                                            </div>
                                            <div class="absolute bottom-3 left-3 right-3">
                                                <h4
                                                    class="text-white font-bold text-sm uppercase tracking-tight truncate">
                                                    <%= featured[2].name %>
                                                </h4>
                                                <span class="text-orange-400 font-mono text-xs font-bold">₹<%=
                                                        featured[2].price.toLocaleString('en-IN') %></span>
                                            </div>
                                </a>
                                <% } %>
                </div>
                <% } else { %>
                    <div class="text-center p-12 border border-zinc-800 bg-zinc-900/50">
                        <span class="text-4xl mb-4 block">🍳</span>
                        <h3 class="text-white font-bold uppercase tracking-wider mb-2">Panda Metals Studio</h3>
                        <p class="text-zinc-400 text-sm">Professional Grade Kitchenware</p>
                    </div>
                    <% } %>
        </div>
    </div>

    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-12 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

            <!-- Hero Content (Left Side) -->
            <div class="py-20 lg:py-32 lg:pr-12">
                <div
                    class="inline-flex items-center gap-3 px-4 py-2 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-bold uppercase tracking-[0.2em] mb-10">
                    <span class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
                    Premium Kitchen Utensils &amp; Cookware
                </div>

                <h1
                    class="font-display font-black text-5xl md:text-7xl lg:text-[5rem] leading-[1.05] tracking-tighter text-zinc-950 dark:text-white mb-8 uppercase">
                    Cook with <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-500">Precision</span>,<br />
                    Live with Style
                </h1>

                <p
                    class="text-zinc-500 dark:text-zinc-400 text-lg md:text-xl leading-relaxed mb-12 max-w-lg font-medium">
                    Discover our curated collection of premium kitchen utensils, professional cookware, quality knives,
                    bakeware, and smart kitchen storage solutions.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                    <a href="/products"
                        class="btn-primary group flex items-center justify-between gap-4 px-8 py-5 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold text-sm uppercase tracking-widest hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors w-full sm:w-auto">
                        <span>Browse Catalog</span>
                        <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </a>
                    <a href="https://api.whatsapp.com/send?phone=<%= String(whatsappNumber).replace(/[^0-9]/g, '') %>&text=<%= encodeURIComponent('Hello! I am interested in your kitchen products. Can we discuss?') %>"
                        target="_blank" rel="noopener noreferrer"
                        class="btn-secondary flex items-center justify-center px-8 py-5 border-2 border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-bold text-sm uppercase tracking-widest hover:border-zinc-950 dark:hover:border-white transition-colors w-full sm:w-auto">
                        Get a Quote
                    </a>
                </div>
            </div>

            <!-- Mobile-only visual preview -->
            <div
                class="h-64 bg-zinc-100 dark:bg-zinc-900 rounded-3xl lg:hidden relative overflow-hidden flex items-center justify-center p-6">
                <span class="text-zinc-500 dark:text-zinc-400 font-mono text-xs uppercase tracking-widest">Explore
                    Catalog Below</span>
            </div>

        </div>
    </div>
</section>

<!-- Category Bento Grid (Image Backgrounds) -->
<section class="py-24 bg-white dark:bg-[#0a0a0a]">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <div class="mb-16 flex items-end justify-between">
            <h2
                class="font-display font-black text-4xl md:text-5xl uppercase tracking-tighter text-zinc-950 dark:text-white">
                Categories</h2>
            <span class="hidden md:block text-zinc-400 font-mono text-sm uppercase tracking-widest">Select to Filter
                //</span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[160px] md:auto-rows-[220px]">
            <% const cats=['Pooja Articles', 'Cookware + Cooker' , 'Kitchenware' , 'Gifting Items' , 'Cooper & Brass'
                , 'Steel Utensils' ]; %>
                <% const
                    bgImages=[ 'https://images.unsplash.com/photo-1605806616949-1e87b487cb2a?q=80&w=800&auto=format&fit=crop'
                    , 'https://images.unsplash.com/photo-1584990347449-a6ab06d7dfd1?q=80&w=800&auto=format&fit=crop'
                    , 'https://images.unsplash.com/photo-1556910103-1c02745a872f?q=80&w=800&auto=format&fit=crop'
                    , 'https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=800&auto=format&fit=crop'
                    , 'https://images.unsplash.com/photo-1611143669185-af224c5e3252?q=80&w=800&auto=format&fit=crop'
                    , 'https://images.unsplash.com/photo-1610992015732-2849b0e38692?q=80&w=800&auto=format&fit=crop' ];
                    %>

                    <% cats.forEach((cat, i)=> { %>
                        <a href="/products?category=<%= encodeURIComponent(cat) %>"
                            class="category-bento-card group relative flex flex-col justify-end p-6 overflow-hidden bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-orange-500 transition-colors
                    <%= (i === 0 || i === 3) ? 'col-span-2 md:col-span-2 row-span-1 md:row-span-2' : 'col-span-1 md:col-span-1 row-span-1' %>">

                            <!-- Background Image & Overlay -->
                            <div class="absolute inset-0 z-0">
                                <img src="<%= bgImages[i] %>" alt="<%= cat %>"
                                    class="w-full h-full object-cover grayscale-[40%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                                    loading="lazy" />
                                <!-- Dark gradient overlay ensures white text is always readable -->
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/60 to-zinc-950/10 opacity-90 group-hover:opacity-60 transition-opacity duration-500">
                                </div>
                            </div>

                            <!-- Card Content (Forced White Text for Contrast) -->
                            <div class="relative z-10 mt-auto">
                                <h3
                                    class="font-display font-bold text-lg md:text-2xl text-white group-hover:text-orange-400 transition-colors uppercase tracking-tight">
                                    <%= cat %>
                                </h3>
                                <div class="h-1 w-0 bg-orange-500 mt-2 group-hover:w-12 transition-all duration-300">
                                </div>
                            </div>
                        </a>
                        <% }) %>
        </div>
    </div>
</section>

<!-- Featured Products: Full-Image Overlay Cards -->
<section class="py-24 bg-zinc-950 dark:bg-[#050505]">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <div class="flex items-end justify-between mb-16 pb-8 border-b border-zinc-800">
            <div>
                <span class="text-orange-500 font-mono text-sm uppercase tracking-[0.2em] block mb-4">Latest
                    Arrivals</span>
                <h2 class="font-display font-black text-4xl md:text-6xl text-white tracking-tighter uppercase">Featured
                </h2>
            </div>
            <a href="/products"
                class="hidden sm:inline-flex items-center gap-2 text-white hover:text-orange-500 font-bold uppercase tracking-widest text-sm transition-colors">
                View All Catalog
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>

        <% if (featured.length===0) { %>
            <div class="w-full py-32 flex flex-col items-center justify-center border border-zinc-800 border-dashed">
                <span class="text-zinc-400 font-mono uppercase tracking-widest">No Inventory Found</span>
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <% featured.forEach(product=> { %>
                        <a href="/products/<%= product.slug %>"
                            class="group relative h-[450px] lg:h-[550px] bg-zinc-900 overflow-hidden block">
                            <% if (product.images && product.images.length> 0) { %>
                                <img src="<%= product.images[0].url %>" alt="<%= product.name %>"
                                    class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                                    loading="lazy" />
                                <% } else { %>
                                    <div
                                        class="absolute inset-0 w-full h-full flex items-center justify-center bg-zinc-900 border border-zinc-800">
                                        <span class="text-zinc-500 font-mono text-xs">NO IMAGE</span>
                                    </div>
                                    <% } %>

                                        <div
                                            class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent opacity-90 group-hover:opacity-70 transition-opacity duration-500">
                                        </div>

                                        <div class="absolute inset-x-0 bottom-0 p-6 flex flex-col justify-end">
                                            <div class="flex justify-between items-start mb-4">
                                                <span
                                                    class="px-2 py-1 bg-white text-zinc-950 text-[10px] font-bold uppercase tracking-widest">
                                                    <%= product.category %>
                                                </span>
                                                <span
                                                    class="text-zinc-400 text-[10px] font-mono uppercase tracking-widest">
                                                    SN: <%= product.serialNo %>
                                                </span>
                                            </div>

                                            <h3
                                                class="font-display font-bold text-2xl text-white mb-2 uppercase tracking-tight line-clamp-1 group-hover:text-orange-500 transition-colors">
                                                <%= product.name %>
                                            </h3>

                                            <p class="text-zinc-400 text-sm mb-6 line-clamp-2 font-medium">
                                                <%= product.description ? product.description.substring(0, 80) + '...'
                                                    : '' %>
                                            </p>

                                            <div
                                                class="flex items-center justify-between border-t border-zinc-800 pt-4">
                                                <span class="font-display font-black text-2xl text-white">
                                                    ₹<%= product.price.toLocaleString('en-IN') %>
                                                </span>
                                                <div
                                                    class="w-10 h-10 bg-orange-600 flex items-center justify-center text-white transform translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M12 4v16m8-8H4" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                        </a>
                        <% }) %>
                </div>
                <% } %>
    </div>
</section>

