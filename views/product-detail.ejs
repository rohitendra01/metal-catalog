<section class="py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="mb-8">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="/" class="text-surface-400 hover:text-brand-600 transition-colors">Home</a></li>
                <li class="text-surface-300">/</li>
                <li><a href="/products" class="text-surface-400 hover:text-brand-600 transition-colors">Products</a>
                </li>
                <li class="text-surface-300">/</li>
                <li class="text-surface-600">
                    <%= product.name %>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
            <!-- Image Gallery -->
            <div class="space-y-4">
                <div class="relative aspect-square rounded-2xl overflow-hidden bg-surface-100 border border-surface-200 cursor-zoom-in"
                    onclick="openLightbox(document.getElementById('mainImage').src)">
                    <% if (product.images && product.images.length> 0) { %>
                        <img id="mainImage" src="<%= product.images[0].url %>" alt="<%= product.name %>"
                            class="w-full h-full object-cover" />
                        <div
                            class="absolute top-3 right-3 bg-black/30 backdrop-blur-sm rounded-lg p-1.5 pointer-events-none">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                            </svg>
                        </div>
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center text-surface-600">
                                <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <% } %>
                </div>

                <% if (product.images && product.images.length> 1) { %>
                    <div class="grid grid-cols-4 gap-3">
                        <% product.images.forEach((img, idx)=> { %>
                            <button onclick="switchImage('<%= img.url %>', this)"
                                class="aspect-square rounded-xl overflow-hidden border-2 border-surface-200 hover:border-brand-500 transition-colors focus:outline-none focus:border-brand-500 <%= idx === 0 ? 'border-brand-500' : '' %>">
                                <img src="<%= img.url %>" alt="<%= product.name %> - Image <%= idx + 1 %>"
                                    class="w-full h-full object-cover" />
                            </button>
                            <% }) %>
                    </div>
                    <% } %>
            </div>

            <!-- Fullscreen Lightbox -->
            <div id="lightbox" onclick="closeLightbox()"
                class="fixed inset-0 z-[999] bg-black/95 hidden items-center justify-center" style="cursor:zoom-out">
                <!-- Close -->
                <button onclick="closeLightbox(); event.stopPropagation()"
                    class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-white/10 hover:bg-white/25 backdrop-blur-sm flex items-center justify-center transition-colors"
                    title="Close (Esc)">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
                <!-- Prev -->
                <button id="lbPrev" onclick="lbNavigate(-1); event.stopPropagation()"
                    class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 backdrop-blur-sm flex items-center justify-center transition-colors hidden"
                    title="Previous">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <!-- Image -->
                <img id="lightboxImg" src="" alt="Fullscreen view"
                    class="max-w-full max-h-full object-contain rounded-xl px-16" onclick="event.stopPropagation()"
                    style="cursor:default" />
                <!-- Next -->
                <button id="lbNext" onclick="lbNavigate(1); event.stopPropagation()"
                    class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 backdrop-blur-sm flex items-center justify-center transition-colors hidden"
                    title="Next">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                <!-- Dots -->
                <div id="lbDots" class="absolute bottom-5 left-1/2 -translate-x-1/2 flex gap-2 z-20"></div>
            </div>

            <div id="_imgData"
                data-imgs='<%- JSON.stringify(product.images ? product.images.map(function (i) { return i.url; }) : []) %>'
                hidden></div>

            <script>
                var _imgs = JSON.parse(document.getElementById('_imgData').dataset.imgs);
                var _lbIdx = 0;

                function switchImage(src, btn) {
                    document.getElementById('mainImage').src = src;
                    _lbIdx = Math.max(0, _imgs.indexOf(src));
                    document.querySelectorAll('.grid.grid-cols-4 button').forEach(function (b) {
                        b.classList.remove('border-brand-500');
                    });
                    if (btn) btn.classList.add('border-brand-500');
                }
                function openLightbox(src) {
                    _lbIdx = Math.max(0, _imgs.indexOf(src));
                    _lbRender();
                    var lb = document.getElementById('lightbox');
                    lb.classList.remove('hidden'); lb.classList.add('flex');
                    document.body.style.overflow = 'hidden';
                }
                function closeLightbox() {
                    var lb = document.getElementById('lightbox');
                    lb.classList.add('hidden'); lb.classList.remove('flex');
                    document.body.style.overflow = '';
                }
                function lbNavigate(dir) {
                    _lbIdx = (_lbIdx + dir + _imgs.length) % _imgs.length;
                    _lbRender();
                }
                function _lbRender() {
                    document.getElementById('lightboxImg').src = _imgs[_lbIdx] || '';
                    var multi = _imgs.length > 1;
                    document.getElementById('lbPrev').classList.toggle('hidden', !multi);
                    document.getElementById('lbNext').classList.toggle('hidden', !multi);
                    document.getElementById('lbDots').innerHTML = multi ? _imgs.map(function (_, i) {
                        return '<span class="w-2 h-2 rounded-full transition-all ' + (i === _lbIdx ? 'bg-white' : 'bg-white/35') + '"></span>';
                    }).join('') : '';
                }
                document.addEventListener('keydown', function (e) {
                    if (document.getElementById('lightbox').classList.contains('hidden')) return;
                    if (e.key === 'Escape') closeLightbox();
                    if (e.key === 'ArrowLeft') lbNavigate(-1);
                    if (e.key === 'ArrowRight') lbNavigate(1);
                });
            </script>

            <!-- Product Info -->
            <div class="flex flex-col">
                <div class="mb-4">
                    <span
                        class="inline-block px-3 py-1 rounded-lg bg-brand-100 text-brand-700 text-sm font-medium border border-brand-200">
                        <%= product.category %>
                    </span>
                </div>

                <h1 class="font-display font-bold text-3xl md:text-4xl text-surface-700 mb-3">
                    <%= product.name %>
                </h1>

                <div class="flex items-center gap-4 mb-6">
                    <span class="font-display font-bold text-3xl text-surface-700">₹<%=
                            product.price.toLocaleString('en-IN') %></span>
                    <span
                        class="text-surface-400 text-sm font-mono bg-surface-100 px-3 py-1 rounded-lg border border-surface-200">SN:
                        <%= product.serialNo %>
                    </span>
                </div>

                <% if (product.description) { %>
                    <div class="mb-8">
                        <h3 class="font-display font-semibold text-surface-700 text-lg mb-3">Description</h3>
                        <p class="text-surface-500 leading-relaxed whitespace-pre-line">
                            <%= product.description %>
                        </p>
                    </div>
                    <% } %>

                        <!-- Specifications -->
                        <% if (product.specifications && Object.keys(product.specifications).length> 0) { %>
                            <div class="mb-8">
                                <h3 class="font-display font-semibold text-surface-700 text-lg mb-3">Specifications</h3>
                                <div class="rounded-xl border border-surface-200 overflow-hidden">
                                    <% Object.entries(product.specifications).forEach(([key, val], idx)=> { %>
                                        <div
                                            class="flex items-center <%= idx % 2 === 0 ? 'bg-surface-100' : 'bg-white' %>">
                                            <span
                                                class="w-1/3 px-4 py-3 text-sm font-medium text-surface-500 border-r border-surface-200">
                                                <%= key %>
                                            </span>
                                            <span class="flex-1 px-4 py-3 text-sm text-surface-700">
                                                <%= val %>
                                            </span>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>
                            <% } %>

                                <p class="text-surface-400 text-sm mb-6">
                                    Added on <%= new Date(product.dateAdded).toLocaleDateString('en-IN', {
                                        day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                                </p>

                                <!-- CTA Buttons -->
                                <div class="flex flex-col sm:flex-row gap-3 mt-auto">
                                    <a href="https://api.whatsapp.com/send?phone=<%= String(whatsappNumber).replace(/[^0-9]/g, '') %>&text=<%= encodeURIComponent('Hello! I am inquiring about the ' + product.name + ' (SN: ' + product.serialNo + '). Could you please provide more details? Thank you!') %>"
                                        target="_blank" rel="noopener noreferrer"
                                        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-brand-700 to-brand-500 text-white font-semibold hover:from-brand-600 hover:to-brand-400 transition-all shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 pulse-glow">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                        </svg>
                                        Inquire Now
                                    </a>
                                    <a href="upi://pay?pa=7909467249-1@idfcfirst&pn=ShalineeSingh&am=<%= product.price %>&tn=<%= encodeURIComponent('Payment for ' + product.name) %>&cu=INR"
                                        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-white border border-surface-200 text-surface-600 font-semibold hover:bg-surface-100 transition-all">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                        </svg>
                                        Pay Now
                                    </a>
                                </div>
            </div>
        </div>

        <!-- Back link -->
        <div class="mt-12 pt-8 border-t border-surface-200">
            <a href="/products"
                class="inline-flex items-center gap-2 text-surface-400 hover:text-brand-600 transition-colors text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to all products
            </a>
        </div>
    </div>
</section>