<section class="py-12 md:py-20 bg-white dark:bg-[#0a0a0a] min-h-screen">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <!-- Structural Breadcrumb -->
        <nav class="mb-12 border-b border-zinc-200 dark:border-zinc-800 pb-6">
            <ol class="flex items-center gap-3 text-xs font-bold uppercase tracking-widest">
                <li><a href="/" class="text-zinc-400 hover:text-orange-600 transition-colors">Home</a></li>
                <li class="text-zinc-300 dark:text-zinc-700">/</li>
                <li><a href="/products" class="text-zinc-400 hover:text-orange-600 transition-colors">Products</a></li>
                <li class="text-zinc-300 dark:text-zinc-700">/</li>
                <li class="text-zinc-950 dark:text-white truncate max-w-[200px] sm:max-w-none">
                    <%= product.name %>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
            <!-- Image Gallery (7 columns) -->
            <div class="lg:col-span-7 space-y-4">
                <div class="relative aspect-square overflow-hidden bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 cursor-zoom-in group"
                    onclick="openLightbox(document.getElementById('mainImage').src)">
                    <% if (product.images && product.images.length> 0) { %>
                        <img id="mainImage" src="<%= product.images[0].url %>" alt="<%= product.name %>"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div
                            class="absolute top-4 right-4 bg-zinc-950 dark:bg-white p-3 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity">
                            <svg class="w-5 h-5 text-white dark:text-zinc-950" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                            </svg>
                        </div>
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center text-zinc-700">
                                <span class="font-mono text-sm uppercase tracking-widest">No Image Available</span>
                            </div>
                            <% } %>
                </div>

                <% if (product.images && product.images.length> 1) { %>
                    <div class="grid grid-cols-4 sm:grid-cols-5 gap-4">
                        <% product.images.forEach((img, idx)=> { %>
                            <button onclick="switchImage('<%= img.url %>', this)"
                                class="relative aspect-square overflow-hidden border-2 border-transparent hover:border-orange-500 transition-colors focus:outline-none <%= idx === 0 ? '!border-zinc-950 dark:!border-white' : '' %>">
                                <img src="<%= img.url %>" alt="<%= product.name %> - Image <%= idx + 1 %>"
                                    class="w-full h-full object-cover" />
                                <div class="absolute inset-0 bg-black/10 hover:bg-transparent transition-colors"></div>
                            </button>
                            <% }) %>
                    </div>
                    <% } %>
            </div>

            <!-- Fullscreen Lightbox (Retained exact logic, updated styles) -->
            <div id="lightbox" onclick="closeLightbox()"
                class="fixed inset-0 z-[999] bg-zinc-950/95 backdrop-blur-md hidden items-center justify-center"
                style="cursor:zoom-out">
                <button onclick="closeLightbox(); event.stopPropagation()"
                    class="absolute top-6 right-6 z-20 w-12 h-12 bg-white text-zinc-950 hover:bg-orange-600 hover:text-white flex items-center justify-center transition-colors"
                    title="Close (Esc)">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
                <button id="lbPrev" onclick="lbNavigate(-1); event.stopPropagation()"
                    class="absolute left-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-white text-zinc-950 hover:bg-orange-600 hover:text-white flex items-center justify-center transition-colors hidden"
                    title="Previous">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <img id="lightboxImg" src="" alt="Fullscreen view"
                    class="max-w-full max-h-[90vh] object-contain px-20 border border-zinc-800 shadow-2xl"
                    onclick="event.stopPropagation()" style="cursor:default" />
                <button id="lbNext" onclick="lbNavigate(1); event.stopPropagation()"
                    class="absolute right-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-white text-zinc-950 hover:bg-orange-600 hover:text-white flex items-center justify-center transition-colors hidden"
                    title="Next">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                <div id="lbDots" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-20"></div>
            </div>

            <div id="_imgData"
                data-imgs='<%- JSON.stringify(product.images ? product.images.map(function (i) { return i.url; }) : []) %>'
                hidden></div>

            <script>
                var _imgs = JSON.parse(document.getElementById('_imgData').dataset.imgs);
                var _lbIdx = 0;
                function switchImage(src, btn) {
                    document.getElementById('mainImage').src = src;
                    _lbIdx = Math.max(0, _imgs.indexOf(src));
                    document.querySelectorAll('.grid button').forEach(function (b) {
                        b.classList.remove('!border-zinc-950', 'dark:!border-white');
                    });
                    if (btn) btn.classList.add('!border-zinc-950', 'dark:!border-white');
                }
                function openLightbox(src) {
                    _lbIdx = Math.max(0, _imgs.indexOf(src));
                    _lbRender();
                    var lb = document.getElementById('lightbox');
                    lb.classList.remove('hidden'); lb.classList.add('flex');
                    document.body.style.overflow = 'hidden';
                }
                function closeLightbox() {
                    var lb = document.getElementById('lightbox');
                    lb.classList.add('hidden'); lb.classList.remove('flex');
                    document.body.style.overflow = '';
                }
                function lbNavigate(dir) {
                    _lbIdx = (_lbIdx + dir + _imgs.length) % _imgs.length;
                    _lbRender();
                }
                function _lbRender() {
                    document.getElementById('lightboxImg').src = _imgs[_lbIdx] || '';
                    var multi = _imgs.length > 1;
                    document.getElementById('lbPrev').classList.toggle('hidden', !multi);
                    document.getElementById('lbNext').classList.toggle('hidden', !multi);
                    document.getElementById('lbDots').innerHTML = multi ? _imgs.map(function (_, i) {
                        return '<span class="w-2 h-2 rounded-none transition-all ' + (i === _lbIdx ? 'bg-orange-500 scale-125' : 'bg-zinc-600') + '"></span>';
                    }).join('') : '';
                }
                document.addEventListener('keydown', function (e) {
                    if (document.getElementById('lightbox').classList.contains('hidden')) return;
                    if (e.key === 'Escape') closeLightbox();
                    if (e.key === 'ArrowLeft') lbNavigate(-1);
                    if (e.key === 'ArrowRight') lbNavigate(1);
                });
            </script>

            <!-- Product Info (5 columns) -->
            <div class="lg:col-span-5 flex flex-col">
                <div class="flex items-center justify-between gap-4 mb-6">
                    <span
                        class="inline-block px-3 py-1 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 text-[10px] font-bold uppercase tracking-widest">
                        <%= product.category %>
                    </span>
                    <span class="text-zinc-400 font-mono text-xs uppercase tracking-widest">
                        SN: <%= product.serialNo %>
                    </span>
                </div>

                <h1
                    class="font-display font-black text-4xl md:text-5xl lg:text-6xl text-zinc-950 dark:text-white mb-6 uppercase tracking-tighter leading-[1.1]">
                    <%= product.name %>
                </h1>

                <div class="pb-8 mb-8 border-b border-zinc-200 dark:border-zinc-800">
                    <span class="font-display font-black text-4xl text-zinc-950 dark:text-white">
                        ₹<%= product.price.toLocaleString('en-IN') %>
                    </span>
                </div>

                <% if (product.description) { %>
                    <div class="mb-10">
                        <h3
                            class="font-mono text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-[0.2em] mb-4">
                            Description</h3>
                        <p
                            class="text-zinc-500 dark:text-zinc-400 leading-relaxed whitespace-pre-line font-medium text-lg">
                            <%= product.description %>
                        </p>
                    </div>
                    <% } %>

                        <!-- Specifications -->
                        <% if (product.specifications && Object.keys(product.specifications).length> 0) { %>
                            <div class="mb-10">
                                <h3
                                    class="font-mono text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-[0.2em] mb-4">
                                    Specifications</h3>
                                <div class="border-t border-zinc-200 dark:border-zinc-800">
                                    <% Object.entries(product.specifications).forEach(([key, val])=> { %>
                                        <div
                                            class="flex items-center py-4 border-b border-zinc-200 dark:border-zinc-800">
                                            <span
                                                class="w-1/3 text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest">
                                                <%= key %>
                                            </span>
                                            <span class="flex-1 text-zinc-500 dark:text-zinc-400 font-medium">
                                                <%= val %>
                                            </span>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>
                            <% } %>

                                <!-- CTA -->
                                <div class="mt-auto pt-8">
                                    <a href="https://api.whatsapp.com/send?phone=<%= String(whatsappNumber).replace(/[^0-9]/g, '') %>&text=<%= encodeURIComponent('Hello! I am inquiring about the ' + product.name + ' (SN: ' + product.serialNo + '). Could you please provide more details? Thank you!') %>"
                                        target="_blank" rel="noopener noreferrer"
                                        class="group flex items-center justify-between w-full px-8 py-5 bg-orange-600 text-white font-bold text-sm uppercase tracking-widest hover:bg-zinc-950 dark:hover:bg-white dark:hover:text-zinc-950 transition-colors">
                                        <span>Inquire About Product</span>
                                        <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform" fill="none"
                                            stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                        </svg>
                                    </a>

                                    <p
                                        class="text-zinc-400 text-[10px] font-mono uppercase tracking-widest mt-4 text-center">
                                        Added to catalog: <%= new Date(product.dateAdded).toLocaleDateString('en-IN', {
                                            day: '2-digit' , month: 'short' , year: 'numeric' }) %>
                                    </p>
                                </div>
            </div>
        </div>
    </div>
</section>