<!-- About Hero -->
<section class="bg-white dark:bg-[#0a0a0a] pt-20 pb-16 md:pt-32 md:pb-24 border-b border-zinc-200 dark:border-zinc-800">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <div class="max-w-4xl fade-in-up">
            <span
                class="inline-block px-3 py-1 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 text-xs font-bold uppercase tracking-widest mb-6">
                Our Story
            </span>
            <h1
                class="font-display font-black text-5xl md:text-7xl lg:text-[5rem] leading-[1.05] text-zinc-950 dark:text-white mb-8 uppercase tracking-tighter">
                About <br />
                <span class="text-orange-600">Panda Metals.</span>
            </h1>
            <p class="text-zinc-500 text-lg md:text-xl leading-relaxed max-w-2xl font-medium">
                Your trusted partner for premium kitchen utensils and cookware. We combine expert curation with a
                passion for quality cooking.
            </p>
        </div>
    </div>
</section>

<!-- Capabilities / Categories Grid -->
<section class="py-24 bg-zinc-50 dark:bg-zinc-950">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <div class="flex items-end justify-between mb-16 pb-8 border-b border-zinc-200 dark:border-zinc-800">
            <h2
                class="font-display font-black text-4xl md:text-5xl uppercase tracking-tighter text-zinc-950 dark:text-white">
                Product Focus</h2>
            <span class="hidden md:block text-zinc-400 font-mono text-sm uppercase tracking-widest">Our Expertise
                //</span>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0a0a0a]">
            <% const capabilities=[ { icon: '🍳' , title: 'Cookware' ,
                desc: 'Non-stick pans, stainless steel pots, pressure cookers, and woks — everything you need for daily cooking and gourmet meals.'
                }, { icon: '🔪' , title: 'Knives & Cutting' ,
                desc: "Chef's knives, bread knives, paring knives, and cutting boards crafted for precision, comfort, and long-lasting sharpness."
                }, { icon: '🧁' , title: 'Bakeware' ,
                desc: 'Baking trays, cake moulds, silicone mats, and loaf pans — perfect for home bakers and pastry enthusiasts.'
                }, { icon: '🥄' , title: 'Kitchen Tools' ,
                desc: 'Spatulas, ladles, whisks, peelers, graters, and tongs — the essential toolkit for every well-equipped kitchen.'
                }, { icon: '📦' , title: 'Storage & Org' ,
                desc: 'Airtight containers, spice racks, pantry organizers, and fridge storage solutions to keep your kitchen tidy.'
                }, { icon: '⚙️' , title: 'Specialty' ,
                desc: 'Mandolines, spiralizers, food mills, and other specialty tools for creative and professional-level cooking.'
                }, ]; %>
                <% capabilities.forEach((cap, i)=> { %>
                    <div
                        class="p-8 md:p-10 border-b border-r border-zinc-200 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors group">
                        <span
                            class="text-4xl block mb-6 grayscale group-hover:grayscale-0 transition-all duration-300 transform origin-left group-hover:scale-110">
                            <%= cap.icon %>
                        </span>
                        <h3
                            class="font-display font-bold text-zinc-950 dark:text-white text-2xl mb-4 uppercase tracking-tight group-hover:text-orange-600 transition-colors">
                            <%= cap.title %>
                        </h3>
                        <p class="text-zinc-500 dark:text-zinc-400 text-sm leading-relaxed font-medium">
                            <%= cap.desc %>
                        </p>
                    </div>
                    <% }) %>
        </div>
    </div>
</section>

<!-- Stats: High Contrast Block -->
<section class="bg-zinc-950 dark:bg-white border-y border-zinc-800 dark:border-zinc-200 py-20">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <div
            class="grid grid-cols-2 md:grid-cols-4 gap-12 text-center divide-x-0 md:divide-x divide-zinc-800 dark:divide-zinc-200">
            <div class="flex flex-col items-center">
                <div class="font-display font-black text-5xl md:text-7xl text-orange-600 mb-2">500+</div>
                <div class="text-zinc-400 dark:text-zinc-500 font-bold uppercase tracking-widest text-xs">Products in
                    Catalog</div>
            </div>
            <div class="flex flex-col items-center">
                <div class="font-display font-black text-5xl md:text-7xl text-orange-600 mb-2">10k+</div>
                <div class="text-zinc-400 dark:text-zinc-500 font-bold uppercase tracking-widest text-xs">Happy
                    Customers</div>
            </div>
            <div class="flex flex-col items-center">
                <div class="font-display font-black text-5xl md:text-7xl text-orange-600 mb-2">50+</div>
                <div class="text-zinc-400 dark:text-zinc-500 font-bold uppercase tracking-widest text-xs">Top Brands
                    Carried</div>
            </div>
            <div class="flex flex-col items-center">
                <div class="font-display font-black text-5xl md:text-7xl text-orange-600 mb-2">100%</div>
                <div class="text-zinc-400 dark:text-zinc-500 font-bold uppercase tracking-widest text-xs">Quality
                    Guaranteed</div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-24 bg-white dark:bg-[#0a0a0a]">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">

            <!-- Contact Info -->
            <div class="lg:col-span-5">
                <span
                    class="inline-block px-3 py-1 bg-zinc-100 dark:bg-zinc-900 text-zinc-950 dark:text-white text-xs font-bold uppercase tracking-widest mb-6 border border-zinc-200 dark:border-zinc-800">
                    Connect
                </span>
                <h2
                    class="font-display font-black text-4xl md:text-6xl text-zinc-950 dark:text-white mb-6 uppercase tracking-tighter">
                    Get In Touch.</h2>
                <p class="text-zinc-500 dark:text-zinc-400 leading-relaxed mb-12 font-medium">
                    Ready to place an order or need help choosing the right kitchen product? Reach out to us for product
                    queries, bulk pricing, or any questions.
                </p>

                <div class="space-y-10 border-t border-zinc-200 dark:border-zinc-800 pt-10">
                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-12 h-12 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center flex-shrink-0 group-hover:bg-orange-600 group-hover:border-orange-600 transition-colors">
                            <svg class="w-5 h-5 text-zinc-950 dark:text-white group-hover:text-white transition-colors"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-zinc-950 dark:text-white uppercase tracking-widest text-sm mb-2">
                                Store Address</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 font-medium">
                                256, Gopal Bagh Road<br />near BSNL Office, Damoh Naka, PNB colony<br />Jabalpur,
                                Madhya Pradesh
                                482002
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-12 h-12 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center flex-shrink-0 group-hover:bg-orange-600 group-hover:border-orange-600 transition-colors">
                            <svg class="w-5 h-5 text-zinc-950 dark:text-white group-hover:text-white transition-colors"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-zinc-950 dark:text-white uppercase tracking-widest text-sm mb-2">
                                Phone</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 font-medium">
                                <a href="https://api.whatsapp.com/send?phone=<%= String(whatsappNumber).replace(/[^0-9]/g, '') %>&text=<%= encodeURIComponent('Hello! I am inquiring from PandaMetals website.') %>"
                                    target="_blank" rel="noopener noreferrer"
                                    class="hover:text-orange-600 transition-colors">+91 9752272888</a><br />
                                Mon–Sat, 9am–6pm IST
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-12 h-12 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center flex-shrink-0 group-hover:bg-orange-600 group-hover:border-orange-600 transition-colors">
                            <svg class="w-5 h-5 text-zinc-950 dark:text-white group-hover:text-white transition-colors"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-zinc-950 dark:text-white uppercase tracking-widest text-sm mb-2">
                                Email</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 font-medium">
                                <a href="mailto:inhouseprintingjbp@gmail.com"
                                    class="hover:text-orange-600 transition-colors">inhouseprintingjbp@gmail.com</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Form (Mailto) -->
            <div class="lg:col-span-7">
                <div
                    class="bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-8 md:p-12 relative">
                    <div class="absolute top-0 left-0 w-full h-1 bg-orange-600"></div>

                    <h3
                        class="font-display font-bold text-2xl text-zinc-950 dark:text-white mb-8 uppercase tracking-tighter">
                        Send Us a Message</h3>
                    <form id="contactForm" class="space-y-6" onsubmit="sendMail(event)">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label
                                    class="block text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Name</label>
                                <input type="text" id="cfName" required
                                    class="w-full px-4 py-3 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 transition-colors"
                                    placeholder="YOUR NAME" />
                            </div>
                            <div>
                                <label
                                    class="block text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Phone</label>
                                <input type="tel" id="cfPhone"
                                    class="w-full px-4 py-3 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 transition-colors"
                                    placeholder="+91 999-999-9999" />
                            </div>
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Email
                                Address</label>
                            <input type="email" id="cfEmail" required
                                class="w-full px-4 py-3 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 transition-colors"
                                placeholder="YOU@EXAMPLE.COM" />
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Message</label>
                            <textarea rows="5" id="cfMessage" required
                                class="w-full px-4 py-3 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 transition-colors resize-none"
                                placeholder="TELL US WHAT YOU ARE LOOKING FOR..."></textarea>
                        </div>
                        <button type="submit"
                            class="w-full py-4 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase tracking-widest hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors mt-4">
                            Initialize Transmission
                        </button>
                    </form>
                    <script>
                        function sendMail(e) {
                            e.preventDefault();
                            var name = document.getElementById('cfName').value.trim();
                            var phone = document.getElementById('cfPhone').value.trim();
                            var email = document.getElementById('cfEmail').value.trim();
                            var msg = document.getElementById('cfMessage').value.trim();
                            var subject = encodeURIComponent('Inquiry from ' + name);
                            var body = encodeURIComponent(
                                'Name: ' + name + '\n' +
                                'Phone: ' + (phone || 'N/A') + '\n' +
                                'Email: ' + email + '\n\n' +
                                'Message:\n' + msg
                            );
                            window.location.href = 'mailto:inhouseprintingjbp@gmail.com?subject=' + subject + '&body=' + body;
                        }
                    </script>
                </div>
            </div>

        </div>
    </div>
</section>