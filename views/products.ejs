<section class="bg-surface-100 dark:bg-[#0f172a] border-b border-surface-200 dark:border-[#1e3a5f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <h1 class="font-display font-bold text-3xl md:text-4xl text-surface-700 dark:text-[#e2eaf8] mb-2">Kitchen Utensils Catalog
        </h1>
        <p class="text-surface-500 dark:text-[#94a3b8]">Browse our complete range of premium kitchen products</p>
    </div>
</section>

<!-- Filters & Search -->
<section
    class="sticky top-16 z-30 bg-white/95 dark:bg-[#0f172a]/95 backdrop-blur-xl border-b border-surface-200 dark:border-[#1e3a5f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
            <!-- Category Filter -->
            <div
                class="flex overflow-x-auto pb-4 -mb-4 scrollbar-hide gap-2 w-full md:flex-wrap md:overflow-visible md:pb-0 md:mb-0">
                <a href="/products"
                    class="category-pill whitespace-nowrap px-4 py-2 rounded-lg text-sm font-medium border border-surface-200 dark:border-[#1e3a5f] <%= currentCategory === 'All' ? 'active bg-brand-600 text-white border-brand-600' : 'text-surface-500 dark:text-[#94a3b8] bg-white dark:bg-[#162033]' %>">
                    All
                </a>

                <% categories.forEach(cat=> { %>
                    <a href="/products?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                        class="category-pill whitespace-nowrap px-4 py-2 rounded-lg text-sm font-medium border border-surface-200 dark:border-[#1e3a5f] <%= currentCategory === cat ? 'active bg-brand-600 text-white border-brand-600' : 'text-surface-500 dark:text-[#94a3b8] bg-white dark:bg-[#162033]' %>">
                        <%= cat %>
                    </a>
                    <% }) %>
            </div>

            <!-- Search -->
            <form action="/products" method="GET" class="flex gap-2 w-full md:w-auto">
                <% if (currentCategory && currentCategory !=='All' ) { %>
                    <input type="hidden" name="category" value="<%= currentCategory %>" />
                    <% } %>
                        <div class="relative flex-1 md:w-64">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-surface-500" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" name="q" value="<%= searchQuery %>"
                                placeholder="Search by name or serial..."
                                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-surface-100 dark:bg-[#1e293b] border border-surface-200 dark:border-[#2d4a6b] text-surface-700 dark:text-[#cbd5e9] placeholder-surface-400 dark:placeholder-[#64748b] focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-sm" />
                        </div>
                        <button type="submit"
                            class="px-5 py-2.5 rounded-xl bg-brand-600 text-white font-medium hover:bg-brand-500 transition-colors text-sm">Search</button>
            </form>
        </div>
    </div>
</section>

<!-- Product Grid -->
<section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <% if (products.length===0) { %>
            <div class="text-center py-20">
                <div class="text-5xl mb-4">🔍</div>
                <h3 class="font-display font-semibold text-xl text-surface-700 dark:text-[#e2eaf8] mb-2">No products
                    found</h3>
                <p class="text-surface-500 dark:text-[#94a3b8] mb-6">Try adjusting your filters or search query</p>
                <a href="/products"
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-white dark:bg-[#162033] border border-surface-200 dark:border-[#1e3a5f] text-brand-600 font-medium hover:bg-surface-100 transition-colors text-sm">
                    Clear Filters
                </a>
            </div>
            <% } else { %>
                <!-- Results count -->
                <p class="text-surface-400 dark:text-[#64748b] text-sm mb-6">
                    <%= pagination.totalCount %> product<%= pagination.totalCount !==1 ? 's' : '' %> found
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 stagger-children">
                    <% products.forEach(product=> { %>
                        <a href="/products/<%= product.slug %>"
                            class="product-card group rounded-2xl bg-white dark:bg-[#162033] border border-surface-200 dark:border-[#1e3a5f] overflow-hidden shadow-sm">
                            <div class="relative aspect-square overflow-hidden bg-surface-100 dark:bg-[#1e293b]">
                                <% if (product.images && product.images.length> 0) { %>
                                    <img src="<%= product.images[0].url %>" alt="<%= product.name %>"
                                        class="w-full h-full object-cover img-zoom" loading="lazy" />
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center text-surface-600">
                                            <svg class="w-16 h-16" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                        <% } %>
                                            <div class="absolute top-3 left-3 z-10">
                                                <span
                                                    class="px-2.5 py-1 rounded-lg bg-white/90 backdrop-blur-sm text-xs font-medium text-brand-700 border border-brand-200">
                                                    <%= product.category %>
                                                </span>
                                            </div>
                            </div>
                            <div class="p-4">
                                <h3
                                    class="font-display font-semibold text-surface-700 dark:text-[#e2eaf8] text-lg mb-1 group-hover:text-brand-600 transition-colors truncate">
                                    <%= product.name %>
                                </h3>
                                <p class="text-surface-400 dark:text-[#64748b] text-xs mb-2 font-mono">SN: <%=
                                        product.serialNo %>
                                </p>
                                <p
                                    class="text-surface-500 dark:text-[#94a3b8] text-sm leading-relaxed mb-3 line-clamp-2">
                                    <%= product.description ? product.description.substring(0, 80) +
                                        (product.description.length> 80 ? '...' : '') : '' %>
                                </p>
                                <div class="flex items-center justify-between">
                                    <span class="font-display font-bold text-xl text-surface-700 dark:text-[#e2eaf8]">₹
                                        <%= product.price.toLocaleString('en-IN') %>
                                    </span>
                                    <span
                                        class="inline-flex items-center gap-1 text-brand-600 text-sm font-medium group-hover:gap-2 transition-all">
                                        Details
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 5l7 7-7 7" />
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </a>
                        <% }) %>
                </div>

                <!-- Pagination -->
                <% if (pagination.totalPages> 1) { %>
                    <div class="flex items-center justify-center gap-2 mt-12">
                        <% if (pagination.page> 1) { %>
                            <a href="/products?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= currentCategory !== 'All' ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                                class="px-4 py-2 rounded-lg bg-white dark:bg-[#162033] border border-surface-200 dark:border-[#1e3a5f] text-surface-600 dark:text-[#94a3b8] hover:bg-surface-100 transition-colors text-sm font-medium">
                                ← Prev
                            </a>
                            <% } %>

                                <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                    <% if (i===pagination.page) { %>
                                        <span class="px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium">
                                            <%= i %>
                                        </span>
                                        <% } else if (Math.abs(i - pagination.page) <=2 || i===1 ||
                                            i===pagination.totalPages) { %>
                                            <a href="/products?page=<%= i %>&limit=<%= pagination.limit %><%= currentCategory !== 'All' ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                                                class="px-4 py-2 rounded-lg bg-white dark:bg-[#162033] border border-surface-200 dark:border-[#1e3a5f] text-surface-600 dark:text-[#94a3b8] hover:bg-surface-100 transition-colors text-sm font-medium">
                                                <%= i %>
                                            </a>
                                            <% } else if (Math.abs(i - pagination.page)===3) { %>
                                                <span class="px-2 text-surface-500 dark:text-[#64748b]">…</span>
                                                <% } %>
                                                    <% } %>

                                                        <% if (pagination.page < pagination.totalPages) { %>
                                                            <a href="/products?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= currentCategory !== 'All' ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                                                                class="px-4 py-2 rounded-lg bg-white dark:bg-[#162033] border border-surface-200 dark:border-[#1e3a5f] text-surface-600 dark:text-[#94a3b8] hover:bg-surface-100 transition-colors text-sm font-medium">
                                                                Next →
                                                            </a>
                                                            <% } %>
                    </div>
                    <% } %>
                        <% } %>
    </div>
</section>