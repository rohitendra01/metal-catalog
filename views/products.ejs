<!-- Catalog Header -->
<section class="bg-white dark:bg-[#0a0a0a] pt-12 pb-8 border-b border-zinc-200 dark:border-zinc-800">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">
        <h1
            class="font-display font-black text-5xl md:text-6xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-4">
            Catalog.
        </h1>
        <p class="text-zinc-500 font-mono text-sm uppercase tracking-widest">
            Browse our complete range of premium kitchen products //
        </p>
    </div>
</section>

<!-- Filters & Search Toolbar -->
<section
    class="sticky top-[80px] z-30 bg-white dark:bg-[#0a0a0a] border-b border-zinc-200 dark:border-zinc-800 shadow-sm">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-4">
        <div class="flex flex-col xl:flex-row gap-6 items-start xl:items-center justify-between">

            <!-- Category Filter -->
            <div
                class="flex overflow-x-auto pb-2 xl:pb-0 scrollbar-hide gap-3 w-full xl:w-auto xl:flex-wrap hide-scrollbar">
                <a href="/products"
                    class="whitespace-nowrap px-6 py-3 text-xs font-bold uppercase tracking-widest border transition-colors
                    <%= currentCategory === 'All' ? 'bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 border-zinc-950 dark:border-white' : 'bg-transparent text-zinc-500 border-zinc-200 dark:border-zinc-800 hover:border-orange-500 hover:text-orange-600' %>">
                    All
                </a>

                <% categories.forEach(cat=> { %>
                    <a href="/products?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                        class="whitespace-nowrap px-6 py-3 text-xs font-bold uppercase tracking-widest border transition-colors
                        <%= currentCategory === cat ? 'bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 border-zinc-950 dark:border-white' : 'bg-transparent text-zinc-500 border-zinc-200 dark:border-zinc-800 hover:border-orange-500 hover:text-orange-600' %>">
                        <%= cat %>
                    </a>
                    <% }) %>
            </div>

            <!-- Search Bar -->
            <form action="/products" method="GET" class="flex w-full xl:w-auto">
                <% if (currentCategory && currentCategory !=='All' ) { %>
                    <input type="hidden" name="category" value="<%= currentCategory %>" />
                    <% } %>
                        <div class="flex w-full xl:w-[400px]">
                            <div
                                class="relative flex-1 border border-zinc-200 dark:border-zinc-800 border-r-0 focus-within:border-orange-500 transition-colors bg-zinc-50 dark:bg-zinc-900">
                                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                                <input type="text" name="q" value="<%= searchQuery %>"
                                    placeholder="SEARCH BY NAME OR SN..."
                                    class="w-full pl-12 pr-4 py-3 bg-transparent text-zinc-950 dark:text-white font-mono text-xs uppercase tracking-widest placeholder-zinc-400 outline-none" />
                            </div>
                            <button type="submit"
                                class="px-8 py-3 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase text-xs tracking-widest hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors">
                                Search
                            </button>
                        </div>
            </form>
        </div>
    </div>
</section>

<!-- Product Grid -->
<section class="py-16 md:py-24 bg-white dark:bg-[#0a0a0a] min-h-[50vh]">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12">

        <% if (products.length===0) { %>
            <div
                class="w-full py-32 flex flex-col items-center justify-center border border-zinc-200 dark:border-zinc-800 border-dashed">
                <span class="text-4xl mb-6 grayscale opacity-50">🔍</span>
                <h3
                    class="font-display font-black text-2xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-2">
                    No Matches Found</h3>
                <p class="text-zinc-500 font-mono text-xs uppercase tracking-widest mb-8">Try adjusting your filters or
                    search query.</p>
                <a href="/products"
                    class="px-8 py-4 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase text-xs tracking-widest hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors">
                    Reset Catalog
                </a>
            </div>
            <% } else { %>
                <!-- Results count -->
                <div class="mb-10 flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
                    <span class="text-zinc-500 font-mono text-xs uppercase tracking-[0.2em]">
                        Showing <%= pagination.totalCount %> item<%= pagination.totalCount !==1 ? 's' : '' %>
                    </span>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 gap-y-10 stagger-children">
                    <% products.forEach(product=> { %>
                        <a href="/products/<%= product.slug %>"
                            class="group flex flex-col h-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0a0a0a] hover:border-orange-500 transition-colors">

                            <!-- Image Area -->
                            <div
                                class="relative aspect-[4/3] bg-zinc-50 dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 overflow-hidden">
                                <% if (product.images && product.images.length> 0) { %>
                                    <img src="<%= product.images[0].url %>" alt="<%= product.name %>"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                        loading="lazy" />
                                    <% } else { %>
                                        <div
                                            class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
                                            <span class="font-mono text-[10px] uppercase tracking-widest">NO
                                                IMAGE</span>
                                        </div>
                                        <% } %>

                                            <!-- Top Overlays -->
                                            <div
                                                class="absolute top-0 left-0 w-full p-4 flex justify-between items-start">
                                                <span
                                                    class="px-2 py-1 bg-zinc-950 text-white text-[10px] font-bold uppercase tracking-widest shadow-sm">
                                                    <%= product.category %>
                                                </span>
                                                <div
                                                    class="w-8 h-8 bg-white/90 dark:bg-zinc-900/90 backdrop-blur border border-zinc-200 dark:border-zinc-700 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                                    <svg class="w-4 h-4 text-zinc-950 dark:text-white" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                                    </svg>
                                                </div>
                                            </div>
                            </div>

                            <!-- Content Area -->
                            <div class="p-6 flex flex-col flex-grow">
                                <span class="text-zinc-400 text-[10px] font-mono uppercase tracking-widest mb-2 block">
                                    SN: <%= product.serialNo %>
                                </span>

                                <h3
                                    class="font-display font-bold text-xl text-zinc-950 dark:text-white uppercase tracking-tight mb-3 group-hover:text-orange-600 transition-colors line-clamp-2">
                                    <%= product.name %>
                                </h3>

                                <p
                                    class="text-zinc-500 dark:text-zinc-400 text-sm mb-6 line-clamp-2 flex-grow font-medium">
                                    <%= product.description ? product.description.substring(0, 80) +
                                        (product.description.length> 80 ? '...' : '') : '' %>
                                </p>

                                <div
                                    class="pt-4 border-t border-zinc-200 dark:border-zinc-800 flex items-end justify-between">
                                    <span class="text-xs font-bold text-zinc-400 uppercase tracking-widest">Price</span>
                                    <span class="font-display font-black text-2xl text-zinc-950 dark:text-white">
                                        ₹<%= product.price.toLocaleString('en-IN') %>
                                    </span>
                                </div>
                            </div>
                        </a>
                        <% }) %>
                </div>

                <!-- Structural Pagination -->
                <% if (pagination.totalPages> 1) { %>
                    <div
                        class="flex items-center justify-center gap-2 mt-20 pt-8 border-t border-zinc-200 dark:border-zinc-800">
                        <% if (pagination.page> 1) { %>
                            <a href="/products?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= currentCategory !== 'All' ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                                class="w-12 h-12 flex items-center justify-center border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white hover:border-orange-500 hover:text-orange-600 transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 19l-7-7 7-7" />
                                </svg>
                            </a>
                            <% } %>

                                <div class="flex gap-1">
                                    <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                        <% if (i===pagination.page) { %>
                                            <span
                                                class="w-12 h-12 flex items-center justify-center bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold font-mono">
                                                <%= i %>
                                            </span>
                                            <% } else if (Math.abs(i - pagination.page) <=1 || i===1 ||
                                                i===pagination.totalPages) { %>
                                                <a href="/products?page=<%= i %>&limit=<%= pagination.limit %><%= currentCategory !== 'All' ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                                                    class="w-12 h-12 flex items-center justify-center border border-zinc-200 dark:border-zinc-800 text-zinc-500 hover:border-orange-500 hover:text-orange-600 transition-colors font-mono">
                                                    <%= i %>
                                                </a>
                                                <% } else if (Math.abs(i - pagination.page)===2) { %>
                                                    <span
                                                        class="w-12 h-12 flex items-center justify-center text-zinc-300 dark:text-zinc-700 font-mono">...</span>
                                                    <% } %>
                                                        <% } %>
                                </div>

                                <% if (pagination.page < pagination.totalPages) { %>
                                    <a href="/products?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= currentCategory !== 'All' ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                                        class="w-12 h-12 flex items-center justify-center border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white hover:border-orange-500 hover:text-orange-600 transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                    <% } %>
                    </div>
                    <% } %>
                        <% } %>
    </div>
</section>