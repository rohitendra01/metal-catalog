        <a href="/products"
          class="block px-3 py-2 rounded-lg text-surface-500 dark:text-slate-400 hover:text-surface-700 dark:hover:text-slate-200 hover:bg-surface-800 dark:hover:bg-slate-800 transition-colors">Products</a>
        <a href="/about"
