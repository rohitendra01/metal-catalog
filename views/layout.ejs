          <!-- KitchenCraft logo mark -->
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-600 to-brand-500 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <span class="font-display font-bold text-xl text-slate-800 dark:text-white tracking-tight group-hover:text-brand-600 transition-colors">Kitchen<span class="text-brand-600">Craft</span></span>
        </a>

        <div class="hidden md:flex items-center gap-1">
          <a href="/" class="nav-link <%= currentPage === 'home' ? 'nav-active' : '' %>">Home</a>
          <a href="/products" class="nav-link <%= currentPage === 'products' ? 'nav-active' : '' %>">Products</a>
          <a href="/about" class="nav-link <%= currentPage === 'about' ? 'nav-active' : '' %>">About</a>
