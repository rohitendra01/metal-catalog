<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panda Metals — Premium Kitchen Utensils</title>
  <meta name="description"
    content="Panda Metals — Premium kitchen utensils, cookware, knives, bakeware, and kitchen tools crafted for the modern home chef." />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <script>
    (function () {
      var s = localStorage.getItem('cv-theme');
      var q = window.matchMedia('(prefers-color-scheme: dark)');
      if (s === 'dark' || (!s && q.matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
