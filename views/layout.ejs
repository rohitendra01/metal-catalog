        <svg class="w-8 h-8 text-white drop-shadow-sm" fill="currentColor" viewBox="0 0 448 512">
          <path
            d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.7 17.8 69.4 27.2 106.1 27.2 122.4 0 222-99.6 222-222 0-59.3-23-115.1-64.9-157.1zM223.9 446.3c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.7-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.5-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 54 81.2 54 130.4 0.1 101.7-82.7 184.5-184.5 184.5zm100.5-137.5c-5.5-2.8-32.6-16.1-37.7-17.9-5.1-1.8-8.8-2.8-12.5 2.8s-14.3 17.9-17.6 21.6-6.4 4.1-12 1.4c-5.5-2.8-23.4-8.6-44.5-27.4-16.4-14.6-27.5-32.7-30.7-38.2-3.2-5.5-0.3-8.5 2.5-11.2 2.5-2.5 5.5-6.4 8.3-9.6 2.8-3.2 3.7-5.5 5.6-9.2 1.8-3.7 0.9-6.9-0.5-9.6-1.4-2.8-12.5-30.2-17.1-41.4-4.5-11-9.1-9.5-12.5-9.7-3.2-0.1-6.9-0.1-10.6-0.1s-9.7 1.4-14.8 6.9c-5.1 5.5-19.4 19-19.4 46.3s19.9 53.7 22.6 57.3c2.8 3.7 39.1 59.7 94.8 83.8 13.3 5.7 23.6 9.2 31.7 11.7 13.3 4.2 25.5 3.6 35.1 2.2 10.7-1.6 32.6-13.3 37.2-26.2 4.6-12.8 4.6-23.8 3.2-26.2-1.3-2.4-5-3.8-10.5-6.6z" />
        </svg>
        <span
          class="absolute right-full mr-3 px-2 py-1 rounded bg-slate-800 text-white text-xs opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-xl">Contact
          us</span>
      </a>
    </div>

    <script>
      (function () {
        const floatBtn = document.getElementById('whatsapp-float');
        const link = document.getElementById('whatsapp-link');
        let isDragging = false;
        let startX, startY, initialX, initialY;

        floatBtn.addEventListener('pointerdown', (e) => {
          // Just record start position, don't capture yet
          startX = e.clientX;
          startY = e.clientY;

          const rect = floatBtn.getBoundingClientRect();
          initialX = rect.left;
          initialY = rect.top;

          isDragging = false;
        });

        window.addEventListener('pointermove', (e) => {
          if (!startX) return; // Not pressing

          const dx = e.clientX - startX;
          const dy = e.clientY - startY;

          if (!isDragging && (Math.abs(dx) > 10 || Math.abs(dy) > 10)) {
            isDragging = true;
            floatBtn.setPointerCapture(e.pointerId);
            floatBtn.style.transition = 'none';
          }

          if (isDragging) {
            floatBtn.style.left = (initialX + dx) + 'px';
            floatBtn.style.top = (initialY + dy) + 'px';
            floatBtn.style.right = 'auto';
            floatBtn.style.bottom = 'auto';
            floatBtn.style.transform = 'none';
          }
        });

        window.addEventListener('pointerup', (e) => {
          if (!startX) return;
          startX = null;

          if (isDragging) {
            floatBtn.style.transition = 'all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
            const centerX = window.innerWidth / 2;

            if (e.clientX < centerX) {
              floatBtn.style.left = '1rem';
              floatBtn.style.right = 'auto';
            } else {
              floatBtn.style.left = 'auto';
              floatBtn.style.right = '1rem';
            }

            floatBtn.style.top = '50%';
            floatBtn.style.transform = 'translateY(-50%)';

            // Prevent the subsequent click event
            const blockClick = (ev) => {
              ev.preventDefault();
              ev.stopImmediatePropagation();
              link.removeEventListener('click', blockClick, true);
            };
            link.addEventListener('click', blockClick, true);
          }
        });
      })();
    </script>
    <% } %>

      <script>
        // Mobile menu
        const menuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
        }

        // ── Theme toggle ──────────────────────────────────────────
        const html = document.documentElement;
        const toggle = document.getElementById('themeToggle');
        const iconMoon = document.getElementById('iconMoon');
        const iconSun = document.getElementById('iconSun');

        function applyTheme(dark) {
          html.classList.toggle('dark', dark);
          if (iconMoon) iconMoon.classList.toggle('hidden', dark);
          if (iconSun) iconSun.classList.toggle('hidden', !dark);
        }

        var saved = localStorage.getItem('cv-theme');
        var sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
        applyTheme(saved === 'dark' || (!saved && sys));

        // Button click
        if (toggle) {
          toggle.addEventListener('click', () => {
            var isDark = !html.classList.contains('dark');
            localStorage.setItem('cv-theme', isDark ? 'dark' : 'light');
            applyTheme(isDark);
          });
        }

        // Follow system changes only when user hasn't made a manual choice
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (!localStorage.getItem('cv-theme')) applyTheme(e.matches);
        });
      </script>

</body>

</html>