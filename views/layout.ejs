<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    KitchenCraft — Premium Kitchen Utensils
  </title>
  <meta name="description"
    content="KitchenCraft — Premium kitchen utensils, cookware, knives, bakeware, and kitchen tools crafted for the modern home chef." />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
              950: '#172554',
            },
            surface: {
              50: '#f8fafc',
              100: '#f0f6ff',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#f0f6ff',
              900: '#f8fafc',
              950: '#ffffff',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Nunito', 'Outfit', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <script>
    (function () {
      var s = localStorage.getItem('cv-theme');
      var q = window.matchMedia('(prefers-color-scheme: dark)');
      if (s === 'dark' || (!s && q.matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body
  class="bg-surface-950 dark:bg-stone-950 text-surface-600 dark:text-stone-300 font-sans min-h-screen flex flex-col antialiased transition-colors duration-200">

  <nav
    class="fixed top-0 w-full z-50 backdrop-blur-xl bg-white/90 dark:bg-slate-900/90 border-b border-surface-200 dark:border-slate-700/50 shadow-sm dark:shadow-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
